{
  "name": "cafe-punto-medio",
  "private": true,
  "version": "0.1.0",
  "description": "Café Punto Medio — premium coffee e-commerce (frontend FSD + backend Hexagonal/DDD)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
