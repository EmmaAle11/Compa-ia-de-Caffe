# Café Punto Medio — environment template. Copy to .env (git-ignored).
# Validated at boot by server/src/config/env.schema.ts — the API refuses to start on invalid values.

NODE_ENV=development
API_PORT=3000

# Origin allowed by CORS (the Vite dev server).
WEB_ORIGIN=http://localhost:5173

# --- Optional while the corresponding adapter is not wired ---

# AI Sommelier recommendation adapter. Without it the adapter returns its static fallback.
GEMINI_API_KEY=

# --- Not wired yet: add to env.schema.ts together with the adapter that needs it ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# SENTRY_DSN=
# POSTHOG_KEY=
